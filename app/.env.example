# Copie este arquivo para app/.env e preencha a chave.
# O arquivo .env não vai para o repositório.
#
# Onde encontrar: console do Firebase > Configurações do projeto >
# Seus aplicativos > Configuração do SDK > apiKey

EXPO_PUBLIC_FIREBASE_API_KEY=cole_a_chave_aqui

# No navegador, use localhost. Em um celular físico, troque localhost pelo
# endereço IPv4 do computador na mesma rede, mantendo a porta 8000.
EXPO_PUBLIC_API_URL=http://localhost:8000
