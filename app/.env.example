# Copie este arquivo para app/.env e preencha os dois valores.
# O arquivo .env não vai para o repositório.
#
# Chave do Firebase: console do Firebase > Configurações do projeto >
# Seus aplicativos > Configuração do SDK > apiKey
EXPO_PUBLIC_FIREBASE_API_KEY=cole_a_chave_aqui

# Endereço da API. Padrão: o serviço publicado no Render, que funciona em
# qualquer máquina e no celular.
EXPO_PUBLIC_API_URL=https://dsi-grupo4.onrender.com

# Para desenvolver com a API rodando na sua máquina, troque por:
#   navegador:       http://localhost:8000
#   celular físico:  http://IP_DO_COMPUTADOR:8000  (mesma rede Wi-Fi)
# Depois de trocar, reinicie o Expo com: npx expo start -c