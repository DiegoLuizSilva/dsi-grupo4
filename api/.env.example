# Configuracao da API do ChurnGuard.
#
# Copiar para `.env` e preencher. O arquivo `.env` esta no .gitignore e NUNCA
# deve ser versionado. Este exemplo pode ser versionado porque nao contem
# nenhum valor real.

# ------------------------------------------------------------------ FIREBASE

# Em DESENVOLVIMENTO: caminho do arquivo de credencial da conta de servico.
# O padrao ja e api/serviceAccountKey.json, entao normalmente nao precisa
# definir nada aqui.
# FIREBASE_CREDENCIAL_ARQUIVO=./serviceAccountKey.json

# Em HOSPEDAGEM: o conteudo do JSON da conta de servico, em uma unica linha.
# Servicos de hospedagem nao aceitam enviar arquivo junto com o codigo, so
# variavel de ambiente. Colar o JSON inteiro, com as quebras de linha da chave
# privada escapadas como \n (o proprio arquivo baixado do Firebase ja vem assim).
# FIREBASE_CREDENCIAL_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}

# ------------------------------------------------------------------- MODELO

# Pasta do pacote exportado pela frente de classificacao. Ver
# ml/CONTRATO_MODELO.md. Em hospedagem, apontar para onde o artefato foi
# copiado dentro do container.
# CHURNGUARD_ARTEFATOS=/app/ml/artefatos

# Permite a API cair para o stub quando o modelo nao esta presente.
# Em DESENVOLVIMENTO deixar em 1, para que as frentes de aplicativo nao
# fiquem bloqueadas. Em HOSPEDAGEM colocar 0: assim a API responde 503 em vez
# de servir uma predicao do stub, que nao vale como resultado.
CHURNGUARD_PERMITIR_STUB=1

# ------------------------------------------------------------------ ACESSO

# Verificacao do token de identidade do Firebase nas rotas de dados e de
# predicao. Em HOSPEDAGEM precisa ficar em 1, que e o padrao. Colocar 0 apenas
# para testar o CRUD localmente sem token.
CHURNGUARD_EXIGIR_AUTENTICACAO=1

# Origens aceitas pelo CORS, separadas por virgula. Nao usar `*` em ambiente
# publicado: com `*`, qualquer pagina web poderia chamar a API com o token da
# pessoa. O aplicativo em dispositivo nao envia cabecalho Origin e nao e
# afetado por esta lista.
# CHURNGUARD_ORIGENS=https://churnguard-app.exemplo.com

# ------------------------------------------------------------------- SERVICO

# Nivel de log: DEBUG, INFO, WARNING, ERROR.
CHURNGUARD_LOG=INFO

# Porta. A maioria dos servicos de hospedagem define PORT automaticamente.
PORT=8000
